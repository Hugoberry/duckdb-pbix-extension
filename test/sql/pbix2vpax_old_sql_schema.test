# name: test/sql/pbix2vpax_old_sql_schema.test
# description: test pbix2vpax function on files with old SQLIte metadata schema
# group: [pbix]

require pbix

# Test basic function call
query I
SELECT COUNT(*) > 0 FROM (SELECT unnest(pbix2vpax('data/sales.pbix').Tables));
----
true

# Test that Tables array is populated
query I
SELECT list_count(pbix2vpax('data/Contoso.pbix').Tables) >0;
----
true

